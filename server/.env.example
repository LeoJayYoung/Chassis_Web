# 本服务不内置 dotenv，请用系统环境变量或命令行方式传入。
# Windows PowerShell 示例：
#   $env:ROSBRIDGE_WS_URL="ws://192.168.43.100:9090"
#   $env:PORT="8080"
#   node src/index.js

PORT=8080
HOST=0.0.0.0
ROSBRIDGE_WS_URL=ws://192.168.43.100:9090
SCHEDULER_RETRY_MS=30000
# 日志保留：超过 N 天的日志定期清理（默认 30 天）
LOG_RETENTION_DAYS=30
# 按条数兜底（0 = 不限制）
LOG_MAX_ROWS=0
# 清理间隔（毫秒，默认 1 小时）
LOG_CLEANUP_INTERVAL_MS=3600000
# DB_PATH 默认是 server/data/chassis.db
# DB_PATH=D:\Chassis Project\chassis-web-ui\server\data\chassis.db

# 日志采集 topic
ROS_TOPIC_ROSOUT=/rosout
ROS_TOPIC_DIAGNOSTICS=/diagnostics
# ROS_TOPIC_STM32_LOG=/stm32_log
# ROS_TOPIC_STM32_LOG_TYPE=std_msgs/msg/String

# Nav2 action
ROS_NAVIGATE_ACTION_NAME=/navigate_to_pose
ROS_NAVIGATE_THROUGH_POSES_ACTION_NAME=/navigate_through_poses
ROS_DEFAULT_FRAME_ID=map
